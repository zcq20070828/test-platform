# 依赖与构建产物
node_modules/
*/node_modules/
**/node_modules/
dist/
*/dist/
**/dist/
frontend/.vite/

# 本地环境配置（含数据库密码，勿提交）
.env
*.local.env
# 2026-10-14防呆: macOS `sed -i` 失败会留下 .envXXXXXX 临时文件(含密钥),
#曾两次被 git add -A 误提交。改为匹配所有 .env* 变体，仅放行 .env.example
.env*
!.env.example

# 数据库文件
*.sqlite
*.sqlite3
runtime/data/evaluation.db
runtime/data/*.sqlite

# 日志与运行产物
*.log
runtime/data/evaluations/
runtime/data/test-runs/

# 系统/编辑器
.DS_Store
.Trash/

# 本地运行时数据（tasks/users/评估/db/克隆仓库），不进版本控制
runtime/

# Python 向量/RAG 服务：源码入库，生成的索引数据不入库
backend/vector/__pycache__/
backend/vector/*.pyc
backend/vector/vector_data/
backend/vector/chroma_db/
backend/vector/bm25_index.json
__pycache__/
*.pyc
