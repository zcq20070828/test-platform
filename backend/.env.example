# ============================================================================
# 测试中台 · 后端环境配置模板
# ----------------------------------------------------------------------------
# 用法：cp .env.example .env  然后填入真实值（.env 已被 .gitignore 排除，不会入库）
# 多人协作：数据库连共用开发库，AI Key 共用同一个，见底部「协作约定」
# ============================================================================

# ---------- 服务器配置 ----------
PORT=3002
NODE_ENV=development
# 开发时前端端口需加入 CORS 白名单（逗号分隔）；多人各自端口不同，按需追加
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
# 后端监听地址：默认 0.0.0.0（局域网可访问）；只允许本机访问时改为 127.0.0.1
BIND_HOST=0.0.0.0

# ---------- 安全配置（2026-10-19 安全整改新增，必填） ----------
# 本地 JWT 签名密钥，生成方式: openssl rand -hex 32
# 缺失时：开发环境自动生成临时密钥（重启后所有登录态失效）并告警；
#         NODE_ENV=production 时直接拒绝启动。
LOCAL_JWT_SECRET=
# 默认管理员密码。不配置时首次启动会生成随机密码并只在日志打印一次；
# 严禁出现 admin123 这类弱口令默认值。
DEFAULT_ADMIN_PASSWORD=

# ---------- 数据库配置（共用开发库） ----------
# ★ 开发库跑在负责人 Mac 上，IP 随其网络变化（换 WiFi 就变）
# ★ 不要在此写死 IP —— 用 ./setup-dev-env.sh 自动探测填入，
#   或向负责人要最新地址（负责人执行 ./get-dev-db-host.sh 即可）
# ★ 开发库是空库，仅有 42 张表结构，供各人随意造数据
DB_HOST=localhost
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=apppwd123
DB_NAME=test_platform_dev
#
# ⚠ 重要：DB_NAME 必须是 test_platform_dev，不要填 test_platform（那是负责人正式库）
# ⚠ 重要：本文件只被 start-dev.sh 读取并注入 process.env；直接 node server.js 不生效
# ⚠ 前提：需与负责人在同一局域网

# ---------- AI 服务配置（直连 DeepSeek） ----------
# 代码实际只用 DEEPSEEK_API_KEY（server.js 直连 https://api.deepseek.com）
# AI_BASE_URL / AI_API_KEY 是历史遗留占位符，当前不生效
#
# ⚠ 安全：真实 Key 不要写在本文件里（本文件会入库）！
#   写 Key 请用脚本（不回显、先校验后原子写入、自动 chmod 600）：
#     ./backend/scripts/set-deepseek-key.sh            # 交互式写入并校验
#     ./backend/scripts/set-deepseek-key.sh --check    # 只校验当前 Key
#   写完后重启后端：./start-dev.sh restart
DEEPSEEK_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# ---------- 向量检索 / ChromaDB ----------
CHROMA_PATH=./chroma_db
# Python 解释器路径：知识库向量服务与文档解析共用，必须指向本机真实 python3
# macOS 常见：/opt/homebrew/bin/python3  或  /usr/local/bin/python3
PLATFORM_PYTHON_PATH=

# ---------- 日志 ----------
LOG_LEVEL=info
LOG_FILE=server.log

# ============================================================================
# 协作约定（多人开发必读）
# ----------------------------------------------------------------------------
# 1. 数据库：所有人的本地后端连同一台开发库（跑在负责人 Mac 上）。
#    DB_HOST 由 ./setup-dev-env.sh 自动探测填入，不要在此写死；
#    - 只读查询随便用，测试数据随便造；
#    - DB_NAME 只能是 test_platform_dev，绝不能填 test_platform；
#    - 改表结构必须写成 backend/migrations/YYYYMMDD_描述.sql，
#      提交后在 main 上由负责人统一执行，避免各自 ALTER 打架。
# 2. 启动方式：必须用 ./start-dev.sh（它会把本文件的值注入 process.env）。
#    直接 node server.js 读不到这里的 DB_* 配置。
#    改完配置要 ./start-dev.sh restart 才会生效。
# 3. 端口：每人本地端口自行错开。后端改 .env 的 PORT（3888/3889…），
#    前端用 ./start-dev.sh 传参或改 FRONTEND_PORT（5174/5175…），不要都占同一端口。
# 4. AI Key：本文件里的 Key 是团队共用的，泄露即失效，请勿外传。
#    .env 已在 .gitignore 排除，真实 Key 只存本地、不入库。
# 5. 每天一个 feature 分支，命名 feature/YYYY-MM-DD-简短描述，
#    收工用 --no-ff 合回 main，再 push。
# 完整说明见项目根目录 COLLABORATION.md
# ============================================================================