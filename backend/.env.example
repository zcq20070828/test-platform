# ============================================================================
# 测试中台 · 后端环境配置模板
# ----------------------------------------------------------------------------
# 用法：cp .env.example .env  然后填入真实值（.env 已被 .gitignore 排除，不会入库）
# 多人协作：数据库连共用开发库，AI Key 共用同一个，见底部「协作约定」
# ============================================================================

# ---------- 服务器配置 ----------
PORT=3002
NODE_ENV=development
# 开发时前端端口需加入 CORS 白名单（逗号分隔）；多人各自端口不同，按需追加
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# ---------- 数据库配置（共用开发库） ----------
# 默认值见 backend/database/db.js；多人协作时 DB_HOST 指向开发库内网地址
DB_HOST=localhost
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=apppwd123
DB_NAME=test_platform

# ---------- AI 服务配置（共用 Key，走内网代理） ----------
# 优先使用 AI_* 系列；若走 DeepSeek 直连则用 DEEPSEEK_API_KEY
AI_BASE_URL=https://your-ai-service.com/v1
AI_MODEL=modelroute
AI_API_KEY=
# 直连 DeepSeek 时使用（二者择一，代码优先读 DEEPSEEK_API_KEY）
DEEPSEEK_API_KEY=

# ---------- 向量检索 / ChromaDB ----------
CHROMA_PATH=./chroma_db
# Python 解释器路径：知识库向量服务与文档解析共用，必须指向本机真实 python3
# macOS 常见：/opt/homebrew/bin/python3  或  /usr/local/bin/python3
PLATFORM_PYTHON_PATH=

# ---------- 日志 ----------
LOG_LEVEL=info
LOG_FILE=server.log

# ============================================================================
# 协作约定（多人开发必读）
# ----------------------------------------------------------------------------
# 1. 数据库：所有人的本地后端连同一台开发库（DB_HOST 填开发库内网 IP）。
#    - 只读查询随便用；
#    - 改表结构必须写成 backend/migrations/YYYYMMDD_描述.sql，
#      提交后在 main 上由负责人统一执行，避免各自 ALTER 打架。
# 2. 端口：每人本地端口自行错开。后端改 .env 的 PORT（3888/3889…），
#    前端用 ./start-dev.sh 传参或改 FRONTEND_PORT（5174/5175…），不要都占同一端口。
# 3. AI Key：本文件留空，由负责人线下分发；严禁把真实 Key 提交到仓库。
# 4. 每天一个 feature 分支，命名 feature/YYYY-MM-DD-简短描述，
#    收工用 --no-ff 合回 main，再 push。
# ============================================================================