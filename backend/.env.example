# 测试中台后端配置模板
# 复制此文件为 .env 并填写实际配置

# 服务器配置
PORT=3000
NODE_ENV=production

# OpenClaw配置
OPENCLAW_GATEWAY_URL=http://localhost:23001
OPENCLAW_CLI_PATH=openclaw

# AI服务配置（根据实际操作修改）
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://your-ai-service.com/v1
AI_MODEL=modelroute

# ChromaDB配置（如果需要向量数据库）
CHROMA_PATH=./chroma_db

# 日志配置
LOG_LEVEL=info
LOG_FILE=server.log

# CORS配置（逗号分隔的域名白名单）
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
